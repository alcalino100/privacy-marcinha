# Banco de dados PostgreSQL (ex.: Neon, Vercel Postgres, Supabase)
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Token da API do gateway AxyraPay (obrigatório para gerar PIX e receber webhooks)
AXYRAPAY_TOKEN=""

# Better Auth — segredo de sessão (gere com: openssl rand -base64 32)
BETTER_AUTH_SECRET=""

# Código de convite exigido para criar a conta de admin (deixe vazio para bloquear cadastro)
ADMIN_SIGNUP_CODE=""

# URL base da aplicação (opcional — em produção a Vercel define automaticamente)
# BETTER_AUTH_URL="https://seu-dominio.com"

# Token de leitura/escrita do Vercel Blob (upload de imagens no admin)
BLOB_READ_WRITE_TOKEN=""
